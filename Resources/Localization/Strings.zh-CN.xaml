<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Menu -->
    <system:String x:Key="Menu.NewGame">新游戏</system:String>
    <system:String x:Key="Menu.Continue">继续游戏</system:String>
    <system:String x:Key="Menu.LoadGame">读取存档</system:String>
    <system:String x:Key="Menu.Settings">设置</system:String>
    <system:String x:Key="Menu.Exit">退出游戏</system:String>

    <!-- Save/Load -->
    <system:String x:Key="SaveLoad.Title">存档 / 读档</system:String>
    <system:String x:Key="SaveLoad.Save">保存</system:String>
    <system:String x:Key="SaveLoad.Load">读取</system:String>
    <system:String x:Key="SaveLoad.EmptySlot">——— 空 ———</system:String>
    <system:String x:Key="SaveLoad.Page">页</system:String>
    <system:String x:Key="SaveLoad.Prev">◀ 上一页</system:String>
    <system:String x:Key="SaveLoad.Next">下一页 ▶</system:String>
    <system:String x:Key="SaveLoad.Close">关闭</system:String>
    <system:String x:Key="SaveLoad.Delete">✕ 删除</system:String>
    <system:String x:Key="SaveLoad.ConfirmOverwrite">确定要覆盖此存档吗？</system:String>
    <system:String x:Key="SaveLoad.Saved">存档成功。</system:String>
    <system:String x:Key="SaveLoad.Loaded">读档成功。</system:String>

    <!-- Settings -->
    <system:String x:Key="Settings.Title">设置</system:String>
    <system:String x:Key="Settings.Audio">音频</system:String>
    <system:String x:Key="Settings.MasterVolume">主音量</system:String>
    <system:String x:Key="Settings.BGMVolume">背景音乐音量</system:String>
    <system:String x:Key="Settings.SFXVolume">音效音量</system:String>
    <system:String x:Key="Settings.VoiceVolume">语音音量</system:String>
    <system:String x:Key="Settings.Display">显示</system:String>
    <system:String x:Key="Settings.Resolution">分辨率</system:String>
    <system:String x:Key="Settings.Fullscreen">全屏显示</system:String>
    <system:String x:Key="Settings.VSync">垂直同步</system:String>
    <system:String x:Key="Settings.ShowFPS">显示帧率</system:String>
    <system:String x:Key="Settings.Language">语言</system:String>
    <system:String x:Key="Settings.Gameplay">游戏</system:String>
    <system:String x:Key="Settings.TextSpeed">文字速度</system:String>
    <system:String x:Key="Settings.AutoAdvance">自动推进</system:String>
    <system:String x:Key="Settings.AutoAdvanceDelay">自动推进延迟</system:String>
    <system:String x:Key="Settings.Apply">应用</system:String>
    <system:String x:Key="Settings.Cancel">取消</system:String>
    <system:String x:Key="Settings.OK">确定</system:String>

    <!-- Game UI -->
    <system:String x:Key="Game.Save">存档</system:String>
    <system:String x:Key="Game.Load">读档</system:String>
    <system:String x:Key="Game.Settings">设置</system:String>
    <system:String x:Key="Game.ReturnToTitle">返回标题画面</system:String>
    <system:String x:Key="Game.ConfirmReturn">确定要返回标题画面吗？未保存的进度将丢失。</system:String>

    <!-- Common -->
    <system:String x:Key="Common.Yes">是</system:String>
    <system:String x:Key="Common.No">否</system:String>
    <system:String x:Key="Common.Confirm">确认</system:String>
    <system:String x:Key="Common.Back">返回</system:String>
</ResourceDictionary>
