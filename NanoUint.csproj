<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NanoUint</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>NanoUint</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NanoUint.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Embedded image resources, loaded uniformly through ResourceManager -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.png" />
    <EmbeddedResource Include="Resources\**\*.jpg" />
  </ItemGroup>

  <!-- WPF resources: XAML styles and localization -->
  <ItemGroup>
    <Resource Include="Resources\Localization\*.xaml" />
    <Resource Include="Resources\Styles\*.xaml" />
  </ItemGroup>

</Project>
